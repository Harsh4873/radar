---
/**
 * Page shell: landmarks, metadata, navigation, and the global stylesheet.
 *
 * Every internal URL is built off `import.meta.env.BASE_URL` because the site
 * is served from https://harsh.bet/radar/ - a root-relative "/" would 404.
 */
import '@/styles/global.css';
import VaultControl from '@/components/VaultControl.astro';
import { url } from '@/lib/view.ts';

interface Props {
  title: string;
  description: string;
  /** Colours the engine chip in the header. */
  engine?: 'research' | 'campus' | null;
  /** ISO timestamp of the ingest that produced this page. */
  fetchedAt?: string | undefined;
  /** Marks the current nav item. */
  current?: string | undefined;
}

const { title, description, engine = null, fetchedAt, current } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://harsh.bet').href;

const fetchedLabel =
  fetchedAt === undefined
    ? null
    : new Date(fetchedAt).toLocaleString('en-US', {
        dateStyle: 'medium',
        timeStyle: 'short',
        timeZone: 'America/Chicago',
      });

const nav = [
  { id: 'home', label: 'Radar', href: url(base, '') },
  { id: 'campus', label: 'Campus', href: url(base, 'campus/') },
  { id: 'profile', label: 'Profile', href: url(base, 'campus/profile/') },
  { id: 'research', label: 'Research', href: url(base, 'research/') },
  { id: 'digests', label: 'Digests', href: url(base, 'research/digests/') },
  { id: 'watchlist', label: 'Saved', href: url(base, 'research/watchlist/') },
  { id: 'sources', label: 'Sources', href: url(base, 'campus/sources/') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    {/* A narrowly scoped feed plus private owner state. Nothing to index. */}
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <div class="brand-lockup">
          <div class="brand">
            <a href={url(base, '')} aria-label="Radar home">RADAR</a>
            {engine === 'research' && <span class="engine engine-research">Research</span>}
            {engine === 'campus' && <span class="engine engine-campus">Campus</span>}
          </div>
          <p>Signals worth your attention.</p>
        </div>
        <nav class="nav" aria-label="Radar sections">
          {
            nav.map((entry) => (
              <a href={entry.href} aria-current={entry.id === current ? 'page' : undefined}>
                {entry.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <VaultControl />

    <main id="main" class="page-main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-brand">
          <strong>RADAR</strong>
          <span>Focused research and campus discovery.</span>
        </div>
        <div class="footer-copy">
          <p>
            Radar reads public research and Texas A&amp;M sources at build time. Every listing links to
            its source, which remains the authority on details. Participant-recruitment studies stay in Studies.
          </p>
          <p>
            Saved, attending, dismissed, tracked, and profile state stays private in this browser unless
            you sign in to the owner vault. Radar has no analytics.
          </p>
        </div>
        {
          fetchedLabel !== null && (
            <p class="footer-freshness">Data gathered {fetchedLabel} (US Central).</p>
          )
        }
      </div>
    </footer>
  </body>
</html>
