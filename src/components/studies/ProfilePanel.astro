---
/**
 * Nine-question self-report form that drives Studies eligibility filtering.
 *
 * Lives on the unified Profile tab. The listing and study pages read the same
 * local-first store; they do not re-ask these questions.
 *
 * DESIGN RULES THIS COMPONENT ENFORCES
 *
 * 1. Every question has an explicit "Prefer not to say", and it is the
 *    default. Unknown is a real answer: the eligibility checker turns an
 *    unanswered criterion into an 'unknown' verdict rather than 'ineligible'.
 *
 * 2. The panel renders unanswered on the server and fills from localStorage
 *    on the client. Nothing about the user is baked into the static HTML.
 *
 * 3. The privacy note is not fine print. It sits above the questions, in the
 *    same size as everything else.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

type Choice = { value: string; label: string };

const YES_NO: Choice[] = [
  { value: '', label: 'Prefer not to say' },
  { value: 'true', label: 'Yes' },
  { value: 'false', label: 'No' },
];

interface Question {
  field: string;
  legend: string;
  help?: string;
  choices: Choice[];
}

const QUESTIONS: Question[] = [
  {
    field: 'rightHanded',
    legend: 'Are you right-handed?',
    help: 'Some brain-imaging studies enrol right-handed participants only.',
    choices: [
      { value: '', label: 'Prefer not to say' },
      { value: 'true', label: 'Right-handed' },
      { value: 'false', label: 'Left-handed or ambidextrous' },
    ],
  },
  {
    field: 'mriSafe',
    legend: 'Can you safely have an MRI scan?',
    help: 'Say no if you have metal in your body, an implanted device, a pacemaker, or you cannot tolerate an enclosed scanner.',
    choices: [
      { value: '', label: 'Prefer not to say' },
      { value: 'true', label: 'Yes, as far as I know' },
      { value: 'false', label: 'No, or I am not sure it is safe' },
    ],
  },
  {
    field: 'hasCardiovascularCondition',
    legend: 'Do you have a cardiovascular condition?',
    help: 'For example heart disease, high blood pressure, or a past cardiac event.',
    choices: YES_NO,
  },
  {
    field: 'isPregnant',
    legend: 'Are you currently pregnant?',
    choices: YES_NO,
  },
  {
    field: 'hasSeizureHistory',
    legend: 'Do you have a history of seizures or epilepsy?',
    choices: YES_NO,
  },
  {
    field: 'sex',
    legend: 'Sex',
    help: 'A handful of studies enrol one sex only. Nothing else uses this.',
    choices: [
      { value: '', label: 'Prefer not to say' },
      { value: 'female', label: 'Female' },
      { value: 'male', label: 'Male' },
      { value: 'other', label: 'Other or intersex' },
    ],
  },
  {
    field: 'willingToFast',
    legend: 'Would you be willing to fast before a visit?',
    help: 'A few studies need you to arrive without having eaten.',
    choices: YES_NO,
  },
  {
    field: 'isTamuStudent',
    legend: 'Are you a Texas A&M student?',
    help: 'Some studies recruit through the university subject pool; a few want non-students.',
    choices: YES_NO,
  },
];
---

<section class:list={['profile-section', 'profile-panel', className]} aria-labelledby="studies-screening-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Studies</p>
      <h2 id="studies-screening-heading">Screening profile</h2>
    </div>
    <p data-profile-count>Not set — nothing is filtered out.</p>
  </div>

  <div class="screening-privacy">
    <p><strong>Private, local-first details.</strong> Answers stay in this browser. If you sign in with a provisioned Google account, they also sync to the private owner vault. There is no analytics. <em>Clear my details</em> wipes the local copy and the synced record.</p>
    <p>
      What you enter only sorts listings into “looks like a fit”, “probably not”, and “cannot tell”. That is a
      <strong>reading of the wording on each listing, not a medical or official determination</strong>.
      Only the study team can say whether you qualify.
    </p>
  </div>

  <noscript>
    <p class="note">This form needs JavaScript. Without it every listing is shown unfiltered, which is the safe default.</p>
  </noscript>

  <form data-profile-form class="screening-form">
    <fieldset class="screening-age">
      <legend>How old are you?</legend>
      <p class="help">Nearly every listing states an age range, so this is the single most useful answer.</p>
      <div class="follow-form">
        <div>
          <input
            type="number"
            inputmode="numeric"
            min="0"
            max="120"
            step="1"
            data-profile-field="age"
            aria-label="Your age in years"
            placeholder="Prefer not to say"
          />
          <button type="button" class="action" data-profile-clear-age>Prefer not to say</button>
        </div>
      </div>
    </fieldset>

    {
      QUESTIONS.map((q) => (
        <fieldset>
          <legend>{q.legend}</legend>
          {q.help && <p class="help">{q.help}</p>}
          <div>
            {q.choices.map((c) => (
              <label class="screening-choice">
                <input
                  type="radio"
                  name={`profile-${q.field}`}
                  value={c.value}
                  data-profile-field={q.field}
                  checked={c.value === ''}
                />
                <span>{c.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }

    <div class="screening-form-actions actions" style="border-top: 1px solid var(--border); padding-top: 0.85rem; margin-top: 0.25rem;">
      <button type="button" class="action" data-profile-clear>Clear my details</button>
      <span data-profile-status role="status" aria-live="polite"></span>
    </div>
  </form>
</section>

<script>
  import {
    PROFILE_FIELD_COUNT,
    answeredCount,
    clearProfile,
    hasStorage,
    setProfile,
    subscribe,
  } from '@/studies/profile.ts';
  import type { Sex, UserProfile } from '@/studies/types.ts';

  const TRISTATE_FIELDS = [
    'rightHanded',
    'mriSafe',
    'hasCardiovascularCondition',
    'isPregnant',
    'hasSeizureHistory',
    'willingToFast',
    'isTamuStudent',
  ] as const;

  type TristateField = (typeof TRISTATE_FIELDS)[number];

  function isTristateField(name: string): name is TristateField {
    return (TRISTATE_FIELDS as readonly string[]).includes(name);
  }

  /** '' means "prefer not to say" and must land as null, never as false. */
  function toTristate(raw: string): boolean | null {
    if (raw === 'true') return true;
    if (raw === 'false') return false;
    return null;
  }

  function toSex(raw: string): Sex | null {
    return raw === 'male' || raw === 'female' || raw === 'other' ? raw : null;
  }

  function countLabel(n: number): string {
    return n === 0
      ? 'Not set — nothing is filtered out.'
      : `${n} of ${PROFILE_FIELD_COUNT} answered`;
  }

  let panelIndex = 0;

  for (const panel of document.querySelectorAll<HTMLElement>('.profile-panel')) {
    const form = panel.querySelector<HTMLFormElement>('[data-profile-form]');
    const status = panel.querySelector<HTMLElement>('[data-profile-status]');
    const count = panel.querySelector<HTMLElement>('[data-profile-count]');
    if (!form) continue;

    const scope = panelIndex++;
    if (scope > 0) {
      for (const input of form.querySelectorAll<HTMLInputElement>('input[type="radio"][name]')) {
        input.name = `${input.name}-${scope}`;
      }
    }

    let applying = false;

    const render = (profile: UserProfile): void => {
      applying = true;
      try {
        const age = form.querySelector<HTMLInputElement>('input[data-profile-field="age"]');
        if (age && document.activeElement !== age) {
          age.value = profile.age === null ? '' : String(profile.age);
        }

        for (const input of form.querySelectorAll<HTMLInputElement>(
          'input[type="radio"][data-profile-field]',
        )) {
          const field = input.dataset['profileField'] ?? '';
          let current = '';
          if (field === 'sex') {
            current = profile.sex ?? '';
          } else if (isTristateField(field)) {
            const v = profile[field];
            current = v === null ? '' : String(v);
          }
          input.checked = input.value === current;
        }
      } finally {
        applying = false;
      }

      const n = answeredCount(profile);
      if (count) count.textContent = countLabel(n);
      for (const output of document.querySelectorAll<HTMLElement>('[data-profile-count="screening"]')) {
        output.textContent = String(n);
      }
      for (const summary of document.querySelectorAll<HTMLElement>('[data-screening-summary]')) {
        summary.textContent = countLabel(n);
      }
      if (status) {
        status.textContent = hasStorage()
          ? n === 0
            ? 'Nothing saved yet.'
            : 'Saved locally; signed-in owner-vault sync runs separately.'
          : 'This browser is blocking local storage, so answers last until you leave the page.';
      }
    };

    const onInput = (event: Event): void => {
      if (applying) return;
      const el = event.target;
      if (!(el instanceof HTMLInputElement)) return;
      const field = el.dataset['profileField'];
      if (!field) return;

      if (field === 'age') {
        const raw = el.value.trim();
        setProfile({ age: raw === '' ? null : Number(raw) });
        return;
      }
      if (!el.checked) return;
      if (field === 'sex') {
        setProfile({ sex: toSex(el.value) });
      } else if (isTristateField(field)) {
        setProfile({ [field]: toTristate(el.value) } as Partial<UserProfile>);
      }
    };

    form.addEventListener('change', onInput);
    form.addEventListener('input', onInput);

    panel.querySelector('[data-profile-clear-age]')?.addEventListener('click', () => {
      setProfile({ age: null });
    });

    panel.querySelector('[data-profile-clear]')?.addEventListener('click', () => {
      clearProfile();
      if (status) status.textContent = 'Cleared. Nothing about you is stored on this device.';
    });

    subscribe(render);
  }
</script>
