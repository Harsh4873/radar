---
/**
 * Tab strip. Filtering happens client-side in `src/client/feed.ts`.
 *
 * These are buttons rather than links because every tab's content is already
 * in the DOM - navigating would re-download the same page to hide different
 * cards. The active tab is mirrored into the URL by the client script so a
 * view is still linkable and survives a reload.
 */
import type { TabDef } from '@/lib/view.ts';

interface Props {
  tabs: readonly TabDef[];
  active?: string;
  /** What is already true of the server HTML when JavaScript is off. */
  note?: string;
}

const {
  tabs,
  active = 'for-you',
  note = 'Tabs, saving, and local re-ranking need JavaScript.',
} = Astro.props;
---

<div class="tabs" role="group" aria-label="Feed filters">
  {
    tabs.map((tab) => (
      <button
        class="tab"
        type="button"
        data-tab={tab.id}
        title={tab.hint}
        aria-pressed={tab.id === active ? 'true' : 'false'}
      >
        {tab.label}
      </button>
    ))
  }
</div>

<noscript>
  <p class="note">{note}</p>
</noscript>
