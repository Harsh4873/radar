<section class="vault-strip" aria-label="Private sync" data-vault-control>
  <div class="wrap vault-strip-inner">
    <p data-vault-status role="status" aria-live="polite">Private sync stays off until you open this section.</p>
    <div class="vault-actions">
      <button class="action" type="button" data-vault-sign-in hidden>Sign in with Google</button>
      <button class="action" type="button" data-vault-sign-out hidden>Sign out</button>
    </div>
  </div>
</section>

<script>
  const details = document.querySelector<HTMLDetailsElement>('details.sync-settings');
  let booted = false;

  async function bootVault(): Promise<void> {
    if (booted) return;
    booted = true;
    const status = document.querySelector<HTMLElement>('[data-vault-status]');
    if (status) status.textContent = 'Checking private sync…';
    try {
      const {
        signInToRadarVault,
        signOutOfRadarVault,
        startRadarVaultSync,
        subscribeVaultStatus,
      } = await import('@/client/vault-sync.ts');

      for (const root of document.querySelectorAll<HTMLElement>('[data-vault-control]')) {
        const rowStatus = root.querySelector<HTMLElement>('[data-vault-status]');
        const signIn = root.querySelector<HTMLButtonElement>('[data-vault-sign-in]');
        const signOut = root.querySelector<HTMLButtonElement>('[data-vault-sign-out]');
        subscribeVaultStatus((next) => {
          signIn?.toggleAttribute('hidden', next.state !== 'signed-out' && next.state !== 'error');
          signOut?.toggleAttribute('hidden', !('email' in next && Boolean(next.email)));
          if (!rowStatus) return;
          if (next.state === 'connecting') rowStatus.textContent = 'Checking private sync…';
          if (next.state === 'signed-out') rowStatus.textContent = 'Sign in to sync your Radar profile, saved items, attendance, tracking, study filters, and feedback.';
          if (next.state === 'syncing') rowStatus.textContent = `Syncing private Radar data${next.email ? ` for ${next.email}` : ''}…`;
          if (next.state === 'synced') rowStatus.textContent = `Private Radar and Studies data is synced${next.email ? ` for ${next.email}` : ''}.`;
          if (next.state === 'error') rowStatus.textContent = next.message;
        });
        signIn?.addEventListener('click', () => {
          signIn.disabled = true;
          void signInToRadarVault().catch((error: unknown) => {
            if (rowStatus) rowStatus.textContent = error instanceof Error ? error.message : 'Google sign-in did not finish.';
          }).finally(() => { signIn.disabled = false; });
        });
        signOut?.addEventListener('click', () => void signOutOfRadarVault());
      }
      startRadarVaultSync();
    } catch {
      booted = false;
      if (status) status.textContent = 'Private sync could not be loaded in this browser.';
    }
  }

  details?.addEventListener('toggle', () => {
    if (details.open) void bootVault();
  });
</script>
