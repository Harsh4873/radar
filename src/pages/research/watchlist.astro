---
/** /radar/research/watchlist - saved papers now live on the unified profile. */
import { url } from '@/lib/view.ts';

const dest = url(import.meta.env.BASE_URL.replace(/\/*$/, '/'), 'profile/#research');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${dest}`} />
    <link rel="canonical" href={dest} />
    <title>Moved — Radar profile</title>
  </head>
  <body>
    <p>
      Saved papers, tracked work, and author watching now live on
      <a href={dest}>your Radar profile</a>.
      A fresh signed-out browser starts with an empty list. Radar keeps an offline browser copy;
      when either provisioned Google account is signed in, saved and tracked state follows through
      the private owner vault. It does not change or target the next ingest.
    </p>
  </body>
</html>
