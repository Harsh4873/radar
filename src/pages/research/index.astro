---
/**
 * /radar/research - the ResearchRadar feed.
 *
 * Opens with the tally, not a search box. The premise of the whole product is
 * that you should not have to go looking: the page tells you how much was
 * scanned, how much matched, and how much is actually worth reading.
 *
 * Every item is rendered once. Tabs and search filter client-side, which is
 * why nine tabs do not mean nine pages.
 */
import Base from '@/layouts/Base.astro';
import DiscoveryControls from '@/components/DiscoveryControls.astro';
import ItemCard from '@/components/ItemCard.astro';
import { fetchedAt, now, research } from '@/lib/data.ts';
import { RESEARCH_TABS, byBand, forYou, recentlyAdded, totalReadingMinutes, url } from '@/lib/view.ts';

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');

const items = research.items;
const core = byBand(items, 'core');
const adjacent = byBand(items, 'adjacent');
const methods = byBand(items, 'methods');
const top = forYou(items);
const forYouIds = new Set(top.map((item) => item.id));
const fresh = recentlyAdded(items, now, 7);

const preprintChanges = research.diff.changes.filter(
  (change) => change.kind === 'preprint-revised' || change.kind === 'preprint-published',
);
---

<Base
  title="ResearchRadar"
  description="Papers ranked against a transparent, published research scope with every reason shown."
  engine="research"
  fetchedAt={fetchedAt}
  current="research"
  layout="wide"
>
  <section class="home-hero research-hero">
    <div>
      <p class="eyebrow">ResearchRadar</p>
      <h1>Papers that match the published scope.</h1>
      <p class="home-hero-lede">
        {research.scanned} candidates scanned across Europe PMC, PubMed, bioRxiv, medRxiv, OpenAlex and
        arXiv. {items.length} matched; {top.length} are probably worth reading.
        About {totalReadingMinutes(top)} minutes if you read them all.
      </p>
      <div class="hero-actions">
        <a class="action action-on-dark" href={url(base, 'profile/#research')}>Open your profile</a>
      </div>
    </div>
    <ul class="home-metrics" aria-label="Research summary">
      <li><strong>{core.length}</strong><span>highly relevant</span></li>
      <li><strong>{adjacent.length}</strong><span>adjacent</span></li>
      <li><strong>{methods.length}</strong><span>methods / tools</span></li>
      <li><strong>{fresh.length}</strong><span>new this week</span></li>
    </ul>
  </section>

  {
    preprintChanges.length > 0 && (
      <section class="section">
        <h2>What changed</h2>
        <p class="note">
          The thing an alert cannot tell you. Radar keeps the previous snapshot and diffs against it.
        </p>
        <div class="panel">
          <ul>
            {preprintChanges.slice(0, 10).map((change) => (
              <li>
                <strong>{change.field}:</strong> {change.before ?? '—'} → {change.after ?? '—'}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="campus-discovery" aria-labelledby="papers-heading">
    <DiscoveryControls
      searchId="paper-search"
      searchLabel="Search papers"
      searchPlaceholder="Search a title, journal, author, or method"
      heading="Papers"
      headingId="papers-heading"
      shown={items.length}
      total={items.length}
      noun="paper"
      tabs={RESEARCH_TABS}
      activeTab="for-you"
    />

    <ul class="feed card-list" data-feed data-default-tab="for-you">
      {items.map((item) => <ItemCard item={item} now={now} inForYou={forYouIds.has(item.id)} />)}
    </ul>

    <p class="empty empty-search" data-empty-state hidden>
      Nothing in this view. Try another filter, or <a href={url(base, 'research/topics/')}>review the published scope</a>
      that decides what Radar looks for.
    </p>
  </section>
</Base>

<script>
  import '@/client/feed.ts';
</script>
