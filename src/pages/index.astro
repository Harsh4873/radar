---
import Base from '@/layouts/Base.astro';
import { campus, fetchedAt, research, studies } from '@/lib/data.ts';
import { url } from '@/lib/view.ts';
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const live = studies.studies.filter((study) => !study.isExpired);
const paths = [
  { title: 'Campus events', copy: 'Find a club, a game, a talk, or something new to try.', path: 'campus/', count: `${campus.items.length} events`, tone: 'campus' },
  { title: 'Participant studies', copy: 'Explore studies by topic, time, format, and stated pay.', path: 'studies/', count: `${live.length} current studies`, tone: 'studies' },
  { title: 'Research papers', copy: 'Discover literature matched to the published research scope.', path: 'research/', count: `${research.items.length} papers`, tone: 'research' },
];
---
<Base title="Radar" description="Find campus events, participant studies, and research papers that interest you." fetchedAt={fetchedAt} current="home" layout="wide">
  <header class="browse-heading home-heading">
    <p class="eyebrow">Your discovery space</p>
    <h1>What are you looking for?</h1>
    <p>Find something interesting. Save it for later. Make it part of your week.</p>
  </header>
  <div class="discovery-paths">
    {paths.map((entry) => (
      <a class="discovery-path" href={url(base, entry.path)}>
        <span class:list={['engine', `engine-${entry.tone}`]}>{entry.count}</span>
        <h2>{entry.title}</h2><p>{entry.copy}</p><span class="path-action">Explore →</span>
      </a>
    ))}
  </div>
  <section class="section quick-start" aria-labelledby="quick-heading">
    <h2 id="quick-heading">Pick up where you left off</h2>
    <div class="quick-links">
      <a href={url(base, 'campus/?personal=interested')}>Saved events</a>
      <a href={url(base, 'campus/?personal=going')}>Events you’re going to</a>
      <a href={url(base, 'studies/?tab=saved')}>Saved studies</a>
      <a href={url(base, 'profile/')}>Your interests &amp; profile</a>
    </div>
  </section>
</Base>
