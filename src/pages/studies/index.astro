---
/**
 * The listing page.
 *
 * Structure of the output, and why:
 *
 *   1. "Ranked by hourly rate"  - every non-expired study whose guaranteed
 *      $/hour could actually be computed, best first. Unpaid studies ($0/hr)
 *      belong here: zero is a measurement.
 *   2. "Rate could not be calculated" - a SEPARATE section, below, never
 *      interleaved. A study with unknown pay is not a cheap study, and
 *      sorting it as if it were 0 would be a claim the data cannot support.
 *   3. "Expired postings" - inside a collapsed <details>, dimmed and badged.
 *      Kept, not deleted: TAMU keeps serving these and a lapsed posting is
 *      often still worth an email.
 *
 * All data is read from src/data/studies.json at BUILD time. Nothing on this
 * page talks to either registry at runtime.
 */
import DiscoveryControls from '@/components/DiscoveryControls.astro';
import FilterBar from '@/components/studies/FilterBar.astro';
import ScreeningStatus from '@/components/studies/ScreeningStatus.astro';
import StudyCard from '@/components/studies/StudyCard.astro';
import snapshotJson from '@/data/studies.json';
import taxonomiesJson from '@/data/studies-taxonomies.json';
import Base from '@/layouts/Base.astro';
import { isKnownRate, sortStudies, sortUnrated } from '@/studies/effective-rate.ts';
import { combinedStudyLocations } from '@/studies/source-display.ts';
import { STUDIES_TABS } from '@/lib/view.ts';
import type { Snapshot, StudyRecord, TaxonomyTerm } from '@/studies/types.ts';

// ---------------------------------------------------------------------------
// Build-time data load.
//
// A bare `import` (not fs) on purpose: Astro bundles page modules before it
// prerenders them, so `import.meta.url` points at a chunk in dist/, and any
// path resolved against it misses src/data entirely. The import also makes the
// dependency real, so a missing snapshot fails the build loudly instead of
// publishing an empty index.
// ---------------------------------------------------------------------------

const snapshot = snapshotJson as unknown as Snapshot;

type TaxonomyFile = Record<string, Record<string, TaxonomyTerm> | TaxonomyTerm[]>;
const taxonomies = taxonomiesJson as unknown as TaxonomyFile;

/** The file has been written as both a keyed map and a flat array. Accept both. */
function termMap(key: string): Map<number, string> {
  const raw = taxonomies[key];
  const terms: TaxonomyTerm[] = Array.isArray(raw)
    ? raw
    : raw === undefined
      ? []
      : Object.values(raw);
  return new Map(terms.filter((t) => t && typeof t.id === 'number').map((t) => [t.id, t.name]));
}

const locationNames = termMap('location');
const sessionTypeNames = termMap('sessionType');

function namesFor(ids: number[], lookup: Map<number, string>): string[] {
  return ids.map((id) => lookup.get(id)).filter((n): n is string => typeof n === 'string');
}

function locationsFor(study: StudyRecord): string[] {
  return combinedStudyLocations(study, namesFor(study.locationIds, locationNames));
}

// ---------------------------------------------------------------------------
// Sectioning. The split is the whole point; see the header comment.
// ---------------------------------------------------------------------------

const all: StudyRecord[] = snapshot.studies;
const live = all.filter((s) => !s.isExpired);
const dead = all.filter((s) => s.isExpired);

const ranked = sortStudies(live.filter((s) => isKnownRate(s.effectiveHourly)));
// Audit F11: this block used to be ordered by posting date alone, which put
// #11321 - $1,000 guaranteed, the largest payout in the corpus - fourth, below
// two studies that state no pay at all. Inside a bucket where the rate is
// unknown by definition, the only fact a reader can act on is the money.
// `sortUnrated` orders by guaranteed total descending, sinks no-stated-pay
// last, and keeps newest-first as the tie-break.
const unrated = sortUnrated(live.filter((s) => !isKnownRate(s.effectiveHourly)));
const expired = sortStudies(dead);

const TAG_LABEL: Record<string, string> = {
  online: 'Online',
  'in-person': 'In person',
  mri: 'MRI',
  eeg: 'EEG',
  'vr-ar': 'VR / AR',
  'focus-group': 'Focus group',
  survey: 'Survey',
  interview: 'Interview',
  clinical: 'Clinical',
  hci: 'Computing / HCI',
};

const tagCounts = new Map<string, number>();
for (const s of live) for (const t of s.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tagFacets = [...tagCounts.entries()]
  .filter(([slug]) => slug !== 'online' && slug !== 'in-person') // covered by the Format select
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([slug, count]) => ({ slug, label: TAG_LABEL[slug] ?? slug, count }));

/**
 * Eligibility criteria, shipped as one JSON blob so the browser can run the
 * SAME `checkEligibility` the rest of the project uses instead of a second,
 * subtly different copy of the rules. Study data only - nothing about the
 * user is ever baked into this file.
 */
const eligibilityById = Object.fromEntries(all.map((s) => [s.id, s.eligibility]));
const eligibilityJson = JSON.stringify(eligibilityById).replace(/</g, '\\u003c');

const description = `${live.length} current participant-study opportunities connected to Texas A&M, with stated pay ranked by guaranteed dollars per hour.`;
---

<Base
  title="Studies — Radar"
  description={description}
  engine="studies"
  fetchedAt={snapshot.fetchedAt}
  current="studies"
  layout="wide"
>
  <div class="studies-app">
    <header class="browse-heading">
      <p class="eyebrow">Participant studies</p>
      <h1>Find a study that fits.</h1>
      <p>Search what interests you. Compare the time, location, and guaranteed pay.</p>
    </header>

    <ScreeningStatus />

    <section class="campus-discovery" aria-labelledby="studies-heading">
      <DiscoveryControls
        searchId="f-q"
        searchLabel="Search studies"
        searchPlaceholder="sleep, MRI, survey, a lab name…"
        heading="Live postings"
        headingId="studies-heading"
        shown={ranked.length + unrated.length}
        total={live.length}
        noun="study"
        tabs={STUDIES_TABS.filter((tab) => !['online', 'inperson'].includes(tab.id))}
        activeTab="all"
      >
        <label class="field study-format"><span class="field-label">Where</span>
          <select class="control" id="f-format">
            <option value="any">Online or in person</option>
            <option value="online">Online</option>
            <option value="inperson">In person</option>
          </select>
        </label>
      </DiscoveryControls>
      <FilterBar tagFacets={tagFacets} />

      <div class="app-main" id="results">
      <p class="note" id="unknown-note" hidden></p>
      <section class="section" id="section-ranked" aria-labelledby="h-ranked">
        <h2 class="section-head" id="h-ranked">Ranked by hourly rate</h2>
        <p class="section-note">
          Guaranteed pay divided by the time the listing says it takes. Studies that list no
          compensation explicitly appear here as unpaid, at the bottom.
        </p>
        <ol class="card-list" id="list-ranked">
          {
            ranked.map((s) => (
              <StudyCard
                study={s}
                locations={locationsFor(s)}
                sessionTypes={namesFor(s.sessionTypeIds, sessionTypeNames)}
              />
            ))
          }
        </ol>
      </section>

      {
        unrated.length > 0 && (
          <section class="section" id="section-unrated" aria-labelledby="h-unrated">
            <h2 class="section-head" id="h-unrated">Rate could not be calculated</h2>
            <p class="section-note">
              These {unrated.length} studies are not ranked and never mixed into the list above.
              Either the pay, the time commitment, or both were missing from the official record,
              or the only compensation is a prize drawing. ClinicalTrials.gov does not publish
              participant compensation, so its registry-only studies stay here as unknown rather
              than being mislabeled unpaid.
            </p>
            <ol class="card-list" id="list-unrated">
              {unrated.map((s) => (
                <StudyCard
                  study={s}
                  locations={locationsFor(s)}
                  sessionTypes={namesFor(s.sessionTypeIds, sessionTypeNames)}
                />
              ))}
            </ol>
          </section>
        )
      }

      <div class="empty" id="empty-state" hidden>
        <h2>No studies match those filters</h2>
        <p>
          Nothing here is hidden for any other reason &mdash; this is the whole set of
          {live.length} live postings filtered down to zero. Try clearing the pay or time limits first;
          they are the two that also exclude studies whose figures could not be parsed.
        </p>
        <button class="btn" type="button" data-reset>Reset filters</button>
      </div>

      {
        expired.length > 0 && (
          <details class="expired-block" id="expired-block">
            <summary>Show {expired.length} expired postings</summary>
            <p class="section-note">
              The ARV listing&rsquo;s own expiration date has passed and no current official registry
              record confirms that it is recruiting. Radar keeps these visible for transparency,
              but treat them as closed unless the study team says otherwise.
            </p>
            <ol class="card-list" id="list-expired">
              {expired.map((s) => (
                <StudyCard
                  study={s}
                  locations={locationsFor(s)}
                  sessionTypes={namesFor(s.sessionTypeIds, sessionTypeNames)}
                />
              ))}
            </ol>
          </details>
        )
      }
      </div>
    </section>
  </div>

  <script type="application/json" id="elig-data" is:inline set:html={eligibilityJson} />
</Base>

<script>
  import '@/client/studies-feed.ts';
</script>
