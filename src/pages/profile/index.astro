---
/** /radar/profile - private campus plans, studies screening, and saved research. */
import Base from '@/layouts/Base.astro';
import ProfilePanel from '@/components/studies/ProfilePanel.astro';
import { campus, fetchedAt, research, studies } from '@/lib/data.ts';
import { CATEGORY_LABELS } from '@/campus/classify.ts';
import { CAMPUS_INTERESTS } from '@/campus/profile.ts';
import type { CampusCategory } from '@/types.ts';
import { byCampusDate, url } from '@/lib/view.ts';
import { isKnownRate } from '@/studies/effective-rate.ts';

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const categoryOrder: CampusCategory[] = [
  'clubs', 'sports', 'companies', 'research', 'academic', 'deadline', 'community',
];
const categoryDescriptions: Record<CampusCategory, string> = {
  clubs: 'Student organizations and social events',
  sports: 'Athletics, sport clubs, and intramurals',
  companies: 'Recruiting, career fairs, and employers',
  research: 'Seminars, symposia, and research groups',
  academic: 'Workshops, training, and campus programs',
  deadline: 'Applications, scholarships, and registration dates',
  community: 'Bryan and College Station events',
};

const organizerCounts = new Map<string, number>();
for (const item of campus.items) {
  const names = new Set<string>();
  const organizer = item.campus?.organizer;
  if (organizer !== null && organizer !== undefined) names.add(organizer);
  for (const source of item.sources) {
    if (source.source === 'getinvolved' && source.channel !== null) names.add(source.channel);
  }
  for (const tag of item.tags) {
    if (tag.toLowerCase().startsWith('organization: ')) names.add(tag.slice('organization: '.length));
  }
  for (const name of names) organizerCounts.set(name, (organizerCounts.get(name) ?? 0) + 1);
}
const organizerSuggestions = [
  'Texas A&M Spikeball',
  'TAMU Badminton Club',
  'Korean Aggies Badminton Club',
  'Texas A&M Pickleball Club',
  "Texas A&M Men's Soccer",
  "Texas A&M University Women's Soccer Club",
  "Texas A&M Women's Rugby Football Club",
  ...[...organizerCounts.entries()]
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .map(([organizer]) => organizer),
].filter((name, index, all) => all.indexOf(name) === index).slice(0, 60);

const campusIndex = [...campus.items].sort(byCampusDate).map((item) => ({
  id: item.id,
  title: item.title,
  startsAt: item.campus?.startsAt ?? null,
  location: item.campus?.location ?? null,
  organizer: item.campus?.organizer ?? null,
  category: item.campus?.category ?? null,
  interests: CAMPUS_INTERESTS
    .filter((interest) => item.reasons.some((reason) => reason.label === interest.label))
    .map((interest) => interest.id),
  search: [item.title, item.summary, item.campus?.organizer ?? '', ...item.tags]
    .join(' ')
    .toLocaleLowerCase(),
  href: url(base, `campus/event/${item.id}/`),
  sourceHref: item.url,
}));

const paperIndex = research.items.map((item) => ({
  id: item.id,
  title: item.title,
  journal: item.research?.journal ?? null,
  date: item.research?.publishedDate ?? null,
  relevance: item.relevance,
  href: url(base, `research/paper/${item.id}/`),
}));

const studyIndex = studies.studies.map((study) => ({
  id: study.id,
  title: study.title,
  href: url(base, `studies/study/${study.slug}/`),
  rate: isKnownRate(study.effectiveHourly) ? study.effectiveHourly : null,
}));

const campusJson = JSON.stringify(campusIndex).replace(/</g, '\\u003c');
const paperJson = JSON.stringify(paperIndex).replace(/</g, '\\u003c');
const studyJson = JSON.stringify(studyIndex).replace(/</g, '\\u003c');
---

<Base
  title="Your Radar profile"
  description="Campus interests, studies screening, and saved research — one private profile."
  fetchedAt={fetchedAt}
  current="profile"
  layout="wide"
>
  <section class="profile-hero">
    <div>
      <p class="eyebrow">Your Radar</p>
      <h1>One private profile for all three feeds.</h1>
      <p>
        Campus interests and plans, the studies screening form, and saved papers live here. Nothing
        here enters public ingest or ranking.
      </p>
      <nav class="profile-jump" aria-label="Profile sections">
        <a href="#campus">Campus</a>
        <a href="#studies">Studies screening</a>
        <a href="#research">Research</a>
      </nav>
    </div>
    <a class="action action-primary" href={url(base, 'campus/')}>Browse the agenda</a>
  </section>

  <div class="profile-layout">
    <aside class="profile-summary" aria-label="Profile summary">
      <div class="panel profile-summary-card">
        <p class="eyebrow">At a glance</p>
        <dl class="profile-stats">
          <div><dt>Going</dt><dd data-profile-count="going">0</dd></div>
          <div><dt>Interested</dt><dd data-profile-count="interested">0</dd></div>
          <div><dt>Screening</dt><dd data-profile-count="screening">0</dd></div>
          <div><dt>Papers</dt><dd data-profile-count="papers">0</dd></div>
          <div><dt>Studies saved</dt><dd data-profile-count="studies">0</dd></div>
          <div><dt>Following</dt><dd data-profile-count="following">0</dd></div>
        </dl>
        <a class="text-link" href={url(base, 'campus/?tab=for-you')}>See campus recommendations →</a>
      </div>

      <div class="panel profile-privacy">
        <h2>Private by design</h2>
        <p>
          A fresh signed-out browser starts with an empty list. Your profile stays in this browser
          and syncs only to the private owner vault when you sign in. It never enters Radar’s public
          data or ranking pipeline. Watched authors do not change or target the next ingest.
        </p>
      </div>
    </aside>

    <div class="profile-content">
      <section class="profile-section" id="campus" aria-labelledby="category-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Campus</p>
            <h2 id="category-heading">Event categories</h2>
          </div>
          <p>Select any mix. Matching events join the <strong>For you</strong> view.</p>
        </div>
        <fieldset class="preference-grid">
          <legend class="sr-only">Preferred campus event categories</legend>
          {
            categoryOrder.map((category) => (
              <label class="preference-option">
                <input type="checkbox" value={category} data-preference-category />
                <span>
                  <strong>{CATEGORY_LABELS[category]}</strong>
                  <small>{categoryDescriptions[category]}</small>
                </span>
              </label>
            ))
          }
        </fieldset>
      </section>

      <section class="profile-section" aria-labelledby="interest-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Topics and activities</p>
            <h2 id="interest-heading">What are you into?</h2>
          </div>
          <p>Includes student organizations, football, intramurals, sport clubs, Spikeball, Badminton, and academic interests.</p>
        </div>
        <fieldset class="interest-grid">
          <legend class="sr-only">Preferred campus topics and activities</legend>
          {
            CAMPUS_INTERESTS.map((interest) => (
              <label class="interest-option">
                <input type="checkbox" value={interest.id} data-preference-interest />
                <span>{interest.label}</span>
              </label>
            ))
          }
        </fieldset>
      </section>

      <section class="profile-section" aria-labelledby="follow-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Clubs and organizers</p>
            <h2 id="follow-heading">Who do you want to follow?</h2>
          </div>
          <p>Follow a club even when it has no event in the current window.</p>
        </div>
        <form class="follow-form" data-follow-form>
          <label for="follow-organizer">Club, team, department, or organizer</label>
          <div>
            <input
              id="follow-organizer"
              name="organizer"
              type="text"
              list="organizer-options"
              autocomplete="off"
              placeholder="Try “Texas A&M Spikeball” or “Rec Sports”"
              data-follow-input
            />
            <button class="action action-primary" type="submit">Follow</button>
          </div>
          <datalist id="organizer-options">
            {organizerSuggestions.map((organizer) => <option value={organizer} />)}
          </datalist>
        </form>
        <ul class="followed-list" data-followed-list></ul>
        <p class="empty compact-empty" data-followed-empty>You are not following any clubs or organizers yet.</p>
        <p class="form-note">
          Following changes your private For you view; it does not change the public ingest or expose
          your preferences. <a href="https://getinvolved.tamu.edu/organizations?loc%5B0%5D=College%20Station" rel="noopener external">Browse the official organization directory →</a>
        </p>
      </section>

      <section class="profile-section" aria-labelledby="plans-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Your plans</p>
            <h2 id="plans-heading">Events you’re going to</h2>
          </div>
          <p>Ordered by date, just like the main agenda.</p>
        </div>
        <ul class="profile-event-list" data-profile-event-list="going"></ul>
        <p class="empty" data-profile-empty="going">Nothing here yet. Mark an event as <strong>Going</strong> from the agenda.</p>
      </section>

      <section class="profile-section" aria-labelledby="saved-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Shortlist</p>
            <h2 id="saved-heading">Events you’re interested in</h2>
          </div>
          <p>Save possibilities now and decide later.</p>
        </div>
        <ul class="profile-event-list" data-profile-event-list="interested"></ul>
        <p class="empty" data-profile-empty="interested">Nothing saved yet. Use <strong>Interested</strong> on any event card.</p>
      </section>

      <div id="studies">
        <ProfilePanel />
      </div>

      <section class="profile-section" aria-labelledby="studies-saved-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Studies</p>
            <h2 id="studies-saved-heading">Saved listings</h2>
          </div>
          <p>The same Save button on the ranked list.</p>
        </div>
        <ul class="profile-event-list" id="profile-studies-saved"></ul>
        <p class="empty" id="profile-studies-saved-empty">Nothing saved yet. Use <strong>Save</strong> on a study card.</p>
      </section>

      <section class="profile-section" id="research" aria-labelledby="papers-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Research</p>
            <h2 id="papers-heading">Saved papers</h2>
          </div>
          <p>Hit Save on any card in the literature feed.</p>
        </div>
        <ul class="profile-event-list" id="profile-papers-saved"></ul>
        <p class="empty" id="profile-papers-saved-empty">Nothing saved yet.</p>
      </section>

      <section class="profile-section" aria-labelledby="tracked-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Research</p>
            <h2 id="tracked-heading">Tracked papers</h2>
          </div>
          <p>Tracking keeps a private shortlist. It does not change or target the next ingest.</p>
        </div>
        <ul class="profile-event-list" id="profile-papers-tracked"></ul>
        <p class="empty" id="profile-papers-tracked-empty">Nothing tracked yet.</p>
      </section>

      <section class="profile-section" aria-labelledby="authors-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Research</p>
            <h2 id="authors-heading">Authors and labs</h2>
          </div>
          <p>A local reference list. Names do not change the published ranking.</p>
        </div>
        <form id="watch-form" class="follow-form">
          <label for="watch-input">Author or lab name</label>
          <div>
            <input id="watch-input" name="name" type="text" placeholder="e.g. Sebastien Gagneux" autocomplete="off" />
            <button class="action action-primary" type="submit">Watch</button>
          </div>
        </form>
        <ul class="badges" id="watch-list" style="margin-top:0.75rem;"></ul>
      </section>

      <section class="profile-section" aria-labelledby="data-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">This browser</p>
            <h2 id="data-heading">Your data</h2>
          </div>
          <p>Export or clear the campus and research record stored here.</p>
        </div>
        <div class="actions" style="border-top:0; padding-top:0; margin-top:0;">
          <button class="action" type="button" id="export-profile">Export as JSON</button>
          <button class="action" type="button" id="reset-profile">Clear saved items</button>
        </div>
      </section>
    </div>
  </div>

  <script is:inline type="application/json" id="campus-profile-index" set:html={campusJson} />
  <script is:inline type="application/json" id="research-profile-index" set:html={paperJson} />
  <script is:inline type="application/json" id="studies-profile-index" set:html={studyJson} />
</Base>

<script>
  import '@/client/campus-profile.ts';
  import '@/client/radar-profile.ts';
</script>
