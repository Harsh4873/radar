---
/** /radar/campus/clubs - student organizations and social events. */
import Base from '@/layouts/Base.astro';
import CategoryFeed from '@/components/CategoryFeed.astro';
import { campus, fetchedAt, now } from '@/lib/data.ts';
import { url } from '@/lib/view.ts';

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const items = campus.items.filter(
  (item) => item.campus?.category === 'clubs' || item.sources.some((source) => source.source === 'getinvolved'),
);
---

<Base
  title="Clubs — CampusRadar"
  description="Student organizations, socials, and campus life events."
  engine="campus"
  fetchedAt={fetchedAt}
  current="campus"
>
  <CategoryFeed
    heading="Clubs"
    lede="Student organizations and campus life from Get Involved plus the Student Activities, MSC, and Student Interest calendars."
    items={items}
    now={now}
    tally={[{ label: 'club events', value: items.length, tone: 'core' }]}
    emptyMessage="No club events in the current window."
  />

  <section class="section">
    <div class="panel prose">
      <h3 style="margin-top:0;">Broader student-organization coverage</h3>
      <p>
        Radar now reads the official Get Involved event directory alongside university calendar
        feeds. Clubs remain in control of what they publish, so an organization with no public event
        will not be invented as an event. You can still follow any club by name from your
        <a href={url(base, 'profile/')}>Radar profile</a>. The
        <a href={url(base, 'campus/sources/')}>Sources page</a> has the details.
      </p>
    </div>
  </section>
</Base>

<script>
  import '@/client/feed.ts';
</script>
