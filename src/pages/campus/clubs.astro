---
/** /radar/campus/clubs - student organizations and social events. */
import Base from '@/layouts/Base.astro';
import CategoryFeed from '@/components/CategoryFeed.astro';
import { campus, fetchedAt, now } from '@/lib/data.ts';
import { byCategory, url } from '@/lib/view.ts';

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const items = byCategory(campus.items, 'clubs');
---

<Base
  title="Clubs — CampusRadar"
  description="Student organizations, socials, and campus life events."
  engine="campus"
  fetchedAt={fetchedAt}
  current="campus"
>
  <CategoryFeed
    heading="Clubs"
    lede="Student organizations and campus life, from the Student Activities, MSC, and Student Interest calendars."
    items={items}
    now={now}
    tally={[{ label: 'club events', value: items.length, tone: 'core' }]}
    emptyMessage="No club events in the current window."
  />

  <section class="section">
    <div class="panel prose">
      <h3 style="margin-top:0;">Coverage is partial, and here is why</h3>
      <p>
        Most student-org events live on Get Involved, which has no public API — every path returns
        the same client-rendered page. What you see here comes from the university calendar groups
        that do publish feeds. The
        <a href={url(base, 'campus/sources/')}>Sources page</a> has the details.
      </p>
    </div>
  </section>
</Base>

<script>
  import '@/client/feed.ts';
</script>
