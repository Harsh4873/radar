---
/** /radar/campus/profile - kept so old links still land on the unified profile. */
import { url } from '@/lib/view.ts';

const dest = url(import.meta.env.BASE_URL.replace(/\/*$/, '/'), 'profile/');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${dest}`} />
    <link rel="canonical" href={dest} />
    <title>Moved — Your Radar profile</title>
  </head>
  <body>
    <p>This page moved to <a href={dest}>your Radar profile</a>.</p>
  </body>
</html>
