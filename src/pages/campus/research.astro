---
/**
 * /radar/campus/research - research organizations and academic events.
 * Participant-recruitment studies belong exclusively in /studies.
 */
import Base from '@/layouts/Base.astro';
import CategoryFeed from '@/components/CategoryFeed.astro';
import { campus, fetchedAt, now } from '@/lib/data.ts';
import { byCategory } from '@/lib/view.ts';

const items = byCategory(campus.items, 'research');
---

<Base
  title="Research Events — CampusRadar"
  description="Research organizations, seminars, symposia, sponsors, and academic events at Texas A&M."
  engine="campus"
  fetchedAt={fetchedAt}
  current="campus"
>
  <CategoryFeed
    heading="Research Events"
    lede="Seminars, symposia, research organizations, sponsors, and academic events from the university calendar. Paid participant studies are intentionally excluded and live in Studies."
    items={items}
    now={now}
    tally={[
      { label: 'listings', value: items.length, tone: 'core' },
      { label: 'academic research events', value: items.length, tone: 'methods' },
    ]}
    emptyMessage="No research listings in the current window."
  />

</Base>

<script>
  import '@/client/feed.ts';
</script>
