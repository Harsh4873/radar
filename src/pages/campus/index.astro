---
/** /radar/campus - chronological campus discovery and personal event planning. */
import Base from '@/layouts/Base.astro';
import CampusAgenda from '@/components/CampusAgenda.astro';
import TabBar from '@/components/TabBar.astro';
import { campus, fetchedAt, now } from '@/lib/data.ts';
import { calendarDaysUntil } from '@/core/text.ts';
import { isIntramuralListing } from '@/campus/classify.ts';
import {
  CAMPUS_TABS,
  byCampusDate,
  forYou,
  formatDateTime,
  recentlyAdded,
  url,
} from '@/lib/view.ts';

const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const items = [...campus.items].sort(byCampusDate);
const top = forYou(items);
const forYouIds = new Set(top.map((item) => item.id));
const fresh = recentlyAdded(items, now, 7);
const today = items.filter((item) => calendarDaysUntil(item.campus?.startsAt ?? null, now) === 0);
const thisWeek = items.filter((item) => {
  const days = calendarDaysUntil(item.campus?.startsAt ?? null, now);
  return days !== null && days >= 0 && days <= 7;
});
const intramurals = items.filter((item) =>
  isIntramuralListing(item.title, item.summary, item.campus?.organizer ?? null, item.tags));
const confirmedFood = items.filter((item) => item.campus?.food.confidence === 'confirmed');
const providedFood = items.filter((item) => item.campus?.food.confidence === 'provided');
const cancelled = items.filter((item) => item.campus?.isCancelled === true);
const nextEvent = items.find((item) => item.campus?.isCancelled !== true) ?? null;

const changes = campus.diff.changes
  .filter((change) => change.kind === 'cancelled' || change.kind === 'location' || change.kind === 'time')
  .slice(0, 6)
  .map((change) => ({
    ...change,
    title: campus.items.find((item) => item.id === change.itemId)?.title ?? 'Event update',
  }));
---

<Base
  title="Campus Radar"
  description="Texas A&M events, clubs, sports, intramurals, and employers in chronological order."
  engine="campus"
  fetchedAt={fetchedAt}
  current="campus"
>
  <section class="campus-hero">
    <div class="campus-hero-copy">
      <p class="eyebrow">Texas A&amp;M · Campus Radar</p>
      <h1>Find what’s happening next.</h1>
      <p class="campus-hero-lede">
        One searchable, date-first agenda for campus events, clubs, sports, intramurals, research,
        and recruiting—without the calendar chaos.
      </p>
      <div class="hero-actions">
        <a class="action action-primary" href="#events">Browse the agenda</a>
        <a class="action action-on-dark" href={url(base, 'campus/profile/')}>Set up your profile</a>
      </div>
    </div>

    <div class="next-event-card">
      <p class="eyebrow">Next on Radar</p>
      {
        nextEvent !== null ? (
          <>
            <p class="next-event-time">{formatDateTime(nextEvent.campus?.startsAt ?? null)}</p>
            <h2>{nextEvent.title}</h2>
            <p>{nextEvent.campus?.location ?? nextEvent.campus?.organizer ?? 'Details at the source'}</p>
            <a href={url(base, `campus/event/${nextEvent.id}/`)}>View event details →</a>
          </>
        ) : (
          <p>No upcoming events are currently available.</p>
        )
      }
    </div>
  </section>

  <ul class="campus-metrics" aria-label="Campus event summary">
    <li><strong>{today.length}</strong><span>happening today</span></li>
    <li><strong>{thisWeek.length}</strong><span>in the next 7 days</span></li>
    <li><strong>{intramurals.length}</strong><span>intramural listings</span></li>
    <li><strong>{fresh.length}</strong><span>added this week</span></li>
  </ul>

  <div class="campus-layout">
    <aside class="campus-sidebar" aria-label="Campus Radar overview">
      <section class="panel sidebar-card">
        <p class="eyebrow">Your Radar</p>
        <h2>Plan once. Keep it together.</h2>
        <p>Mark events as Interested or Going, follow clubs, and choose the activities you care about.</p>
        <a class="action action-primary" href={url(base, 'campus/profile/')}>Open your profile</a>
      </section>

      {
        changes.length > 0 && (
          <details class="panel sidebar-details">
            <summary>{changes.length} recent event changes</summary>
            <ul>
              {changes.map((change) => (
                <li>
                  <strong>{change.title}</strong>
                  <span>{change.field}: {change.before ?? '—'} → {change.after ?? '—'}</span>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      <details class="panel sidebar-details">
        <summary>How food labels work</summary>
        <div class="sidebar-detail-body">
          <ul class="badges">
            <li class="food food-confirmed">Free food confirmed</li>
            <li class="food food-provided">Food provided</li>
            <li class="food food-mentioned">Food mentioned</li>
          </ul>
          <p>
            {confirmedFood.length} confirmed · {providedFood.length} provided. “Mentioned” never means free.
          </p>
        </div>
      </details>

      <section class="panel sidebar-card coverage-card">
        <p class="eyebrow">Coverage</p>
        <h2>{campus.scanned} listings checked</h2>
        <p>
          Radar reads the official university calendar plus dedicated Rec Sports feeds. Participant
          recruitment remains exclusively in Studies.
        </p>
        <a class="text-link" href={url(base, 'campus/sources/')}>Review every source →</a>
      </section>
    </aside>

    <section class="campus-discovery" id="events" aria-labelledby="agenda-heading">
      <div class="discovery-controls">
        <form class="event-search" role="search" data-search-form>
          <label for="event-search">Search campus events</label>
          <div class="search-field">
            <input
              id="event-search"
              type="search"
              name="q"
              placeholder="Search an event, club, sport, location, or date"
              autocomplete="off"
              data-event-search
            />
            <button class="action search-clear" type="button" data-clear-search hidden>Clear</button>
          </div>
        </form>

        <div class="filter-heading">
          <div>
            <p class="eyebrow">Filters</p>
            <h2 id="agenda-heading">Upcoming events</h2>
          </div>
          <p>
            <span data-count-for="visible">{items.length}</span> of {items.length} shown
          </p>
        </div>
        <TabBar tabs={CAMPUS_TABS} active="all" />

        <div class="filter-utility">
          <p data-search-summary role="status" aria-live="polite">{items.length} events shown.</p>
          <button class="text-button" type="button" data-show-dismissed aria-pressed="false">
            Show dismissed{cancelled.length > 0 && <> · {cancelled.length} cancelled</>}
          </button>
        </div>
      </div>

      <CampusAgenda items={items} now={now} defaultTab="all" forYouIds={forYouIds} />

      <div class="empty empty-search" data-empty-state hidden>
        <h2>No events match that view.</h2>
        <p>Try a broader search or clear the filters to return to the full chronological agenda.</p>
        <button class="action action-primary" type="button" data-reset-filters>Show all events</button>
      </div>
    </section>
  </div>
</Base>

<script>
  import '@/client/feed.ts';
</script>
