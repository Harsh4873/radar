{
  "name": "radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Three-engine discovery system: literature, Texas A&M campus, and paid participant studies. Shared ingestion, ranking, and change detection.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run ingest && astro build",
    "preview": "astro preview",
    "ingest": "node --experimental-strip-types scripts/ingest.ts",
    "ingest:research": "node --experimental-strip-types scripts/ingest.ts --only=research",
    "ingest:campus": "node --experimental-strip-types scripts/ingest.ts --only=campus",
    "ingest:studies": "node --experimental-strip-types scripts/ingest.ts --only=studies",
    "ingest:offline": "node --experimental-strip-types scripts/ingest.ts --offline",
    "capture:fixtures": "node --experimental-strip-types scripts/capture-fixtures.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:rules": "npx --yes firebase-tools emulators:exec --project demo-radar-vault --only firestore \"vitest run src/firestore.rules.test.ts --testTimeout=60000\"",
    "deploy:rules": "npx --yes firebase-tools deploy --only firestore:rules --project pickledgerpro",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "astro": "7.2.0",
    "firebase": "^12.16.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
