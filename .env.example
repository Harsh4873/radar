# All of these are OPTIONAL. Radar ingests fine with none of them set; they
# only raise rate limits or unlock a politeness pool.

# NCBI API key. Without one, E-utilities allows 3 requests/second per IP;
# with one, 10/second. https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
NCBI_API_KEY=

# Contact address sent to Crossref and OpenAlex as `mailto=`. Both operate a
# faster "polite pool" for requests that identify themselves. This is read
# from the environment at ingest time and NEVER written into committed files
# or build output - see the email guard in .github/workflows/ci.yml.
RADAR_CONTACT_EMAIL=
